NEO4J_URI="neo4j+s://xxxx.databases.neo4j.io"
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
OPENAI_API_KEY="sk-.."

# Optional — defaults shown are what the code falls back to
NEO4J_DATABASE=neo4j
# ch08 runs the Neo4j MCP server read-only by default
NEO4J_READ_ONLY=true
# Chat model used by the ch03/ch08/ch09 agents
OPENAI_MODEL=gpt-5
# ch12 evaluation: the model that grades answers
JUDGE_MODEL=gpt-5
# ch12 evaluation: the model under test
TARGET_MODEL=gpt-5.4-mini
